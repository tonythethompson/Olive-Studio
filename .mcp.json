{
  "mcpServers": {
    "olive": {
      "type": "stdio",
      "command": "python",
      "args": ["olive-mcp-server/run.py"],
      "env": {
        "OLIVE_MCP_RETRIEVAL_MODE": "auto"
      }
    },

    "serena": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "serena-agent==1.6.1",
        "serena",
        "start-mcp-server",
        "--project-from-cwd"
      ]
    }
  }
}
