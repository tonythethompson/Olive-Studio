{
  "mcpServers": {
    "olive": {
      "type": "stdio",
      "command": "python",
      "args": ["olive-mcp-server/run.py"]
    },
    "serena": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--project-from-cwd"
      ]
    }
  }
}
