# ── AI providers (first non-empty match wins at server start) ─────────────────
# Gemini / Google AI
GEMINI_API_KEY=""
# GOOGLE_API_KEY=""
# GOOGLE_GENAI_API_KEY=""

# OpenAI platform API (usage-based key — not ChatGPT browser login)
# OPENAI_API_KEY=""

# Codex ChatGPT subscription uses local `codex` CLI auth (Assistant → OpenAI Codex → Sign in).
# Optional override for the binary path:
# CODEX_PATH=codex

# Anthropic
# ANTHROPIC_API_KEY=""

# Mistral
# MISTRAL_API_KEY=""

# xAI (Grok)
# XAI_API_KEY=""

# OpenRouter
# OPENROUTER_API_KEY=""

# Groq
# GROQ_API_KEY=""

# Together AI
# TOGETHER_API_KEY=""

# GitHub Copilot chat endpoint (prefer IDE/session token over classic PAT)
# GITHUB_COPILOT_TOKEN=""
# GITHUB_TOKEN=""

# Kilo AI Gateway (https://api.kilo.ai/api/gateway)
# KILO_API_KEY=""
# KILOCODE_API_KEY=""

# Hugging Face (optional — gated models during olive run)
# HF_TOKEN=""

# LM Studio local server token (optional)
# LM_API_TOKEN=""
# LM_STUDIO_API_KEY=""

# Knowledge-base sync (optional). When set, POST /api/mcp/sync-kb requires header x-sync-token.
# Local desktop/browser same-origin sync works without this.
# SYNC_KB_TOKEN=""
# VITE_SYNC_KB_TOKEN=""

# Copy to .env or .env.local and restart: pnpm dev / pnpm tauri:dev
# Session keys saved in Assistant → Settings are memory-only (not written to disk).
