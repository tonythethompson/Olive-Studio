# Gemini / Google AI (either name works)
GEMINI_API_KEY=""
# GOOGLE_API_KEY=""

# OpenAI
# OPENAI_API_KEY=""

# Anthropic
# ANTHROPIC_API_KEY=""

# Mistral
# MISTRAL_API_KEY=""

# Hugging Face (optional — for gated/private models during olive run)
# HF_TOKEN=""

# Knowledge-base sync (optional). When set, POST /api/mcp/sync-kb requires header x-sync-token.
# Local desktop/browser same-origin sync works without this. Only set if you lock the endpoint down.
# SYNC_KB_TOKEN=""
# Frontend must send the same value when the server requires it:
# VITE_SYNC_KB_TOKEN=""

# Copy to .env or .env.local and restart: pnpm dev
# Session keys can also be saved in AI Copilot → Settings (memory only, not written to disk).
