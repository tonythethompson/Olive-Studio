{
  "name": "olive-studio",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "description": "GUI for Microsoft Olive model optimization — runs locally, no cloud required",
  "type": "module",
  "bin": {
    "olive-studio": "./bin/cli.js"
  },
  "files": [
    "dist/",
    "bin/"
  ],
  "packageManager": "pnpm@10.8.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "preinstall": "node -e \"if (!/pnpm/.test(process.env.npm_execpath || \\\"\\\")) { console.error('Use pnpm install, not npm install'); process.exit(1); }\"",
    "postinstall": "husky",
    "dev": "tsx server.ts",
    "generate:recipes": "node scripts/generate-olive-recipes-catalog.mjs",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:threshold": "vitest run --coverage --coverage.thresholds.lines=90 --coverage.thresholds.statements=88 --coverage.thresholds.branches=80 --coverage.thresholds.functions=85 --coverage.thresholds.perFile=true",
    "test:watch": "vitest",
    "lint": "tsc --noEmit && eslint",
    "validate:recipe": "tsx scripts/validate-recipe-builder.ts",
    "a11y:scan": "python tools/a11y-scan.py src",
    "eslint": "eslint --max-warnings 0 src/ server.ts",
    "prepare": "husky",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "deepcheck": "tsc --noEmit && prettier --check \"src/**/*.{ts,tsx}\" && eslint"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "server.ts": [
      "prettier --write",
      "eslint --fix"
    ],
    "src/**/*.css": [
      "prettier --write"
    ],
    "**/*.json": [
      "prettier --write"
    ],
    "**/*.md": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@mendable/firecrawl-js": "^4.30.1",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.101.0",
    "@types/uuid": "^10.0.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "onnxruntime-web": "^1.27.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "uuid": "^14.0.0",
    "vite": "^8.0.16"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@playwright/test": "^1.61.1",
    "@types/express": "^4.17.21",
    "@types/jszip": "^3.4.0",
    "@types/node": "^22.14.0",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react-swc": "^4.3.2",
    "@vitest/coverage-v8": "^4.1.10",
    "@webgpu/types": "^0.1.71",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typegpu": "^0.11.9",
    "typescript": "~5.8.2",
    "unplugin-typegpu": "^0.11.6",
    "vite": "^8.0.16",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^4.1.10"
  }
}
