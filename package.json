{
  "name": "olive-studio",
  "private": true,
  "version": "0.5.0",
  "license": "MIT",
  "description": "GUI for Microsoft Olive model optimization — runs locally, no cloud required",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "bin": {
    "olive-studio": "./bin/cli.js"
  },
  "files": [
    "dist/",
    "bin/"
  ],
  "packageManager": "pnpm@11.17.0",
  "pnpm": {
    "overrides": {
      "nanoid": ">=3.3.18"
    }
  },
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "preinstall": "node -e \"if (!/pnpm/.test(process.env.npm_execpath || \\\"\\\")) { console.error('Use pnpm install, not npm install'); process.exit(1); }\" && node scripts/fix-stale-symlinks.mjs",
    "dev": "tsx server.ts",
    "generate:recipes": "node scripts/generate-olive-recipes-catalog.mjs",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.mjs",
    "start": "node dist/server.mjs",
    "clean": "rm -rf dist server.js dist/server.cjs dist/server.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:threshold": "vitest run --coverage --coverage.thresholds.lines=90 --coverage.thresholds.statements=88 --coverage.thresholds.branches=80 --coverage.thresholds.functions=85 --coverage.thresholds.perFile=true",
    "test:server": "vitest run --config vitest.server.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:component": "vitest run --config vitest.component.config.ts",
    "test:watch": "vitest",
    "lint": "tsc --noEmit && eslint",
    "lint:quick": "oxlint --import-plugin src/",
    "validate:recipe": "tsx scripts/validate-recipe-builder.ts",
    "mcp:native-smoke": "python olive-mcp-server/scripts/smoke_native.py",
    "mcp:benchmark": "python olive-mcp-server/scripts/benchmark_cold_warm.py",
    "mcp:agent-smoke": "node scripts/mcp-agent-smoke.mjs",
    "mcp:build-index": "python olive-mcp-server/scripts/build_kb_index.py",
    "a11y:scan": "python tools/a11y-scan.py src",
    "eslint": "eslint --max-warnings 20 src/ server.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "deepcheck": "tsc --noEmit && prettier --check \"src/**/*.{ts,tsx}\" && eslint",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "driver.js": "^1.8.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "express-static-gzip": "^3.0.1",
    "fflate": "^0.8.3",
    "helmet": "^8.3.0",
    "lucide-react": "^1.27.0",
    "onnxruntime-web": "^1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "uuid": "^14.0.1",
    "zustand": "^5.0.14"
  },
  "optionalDependencies": {
    "@openai/codex-sdk": "^0.147.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/react": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@storybook/test": "^8.6.18",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "@webgpu/types": "^0.1.71",
    "autoprefixer": "^10.5.4",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.9.0",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "prettier": "^3.9.6",
    "rollup-plugin-visualizer": "^7.0.1",
    "storybook": "^8.6.18",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.10",
    "typegpu": "^0.11.9",
    "typescript": "~6.0.3",
    "unplugin-typegpu": "^0.11.6",
    "vite": "^8.2.1",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^4.1.10"
  }
}
